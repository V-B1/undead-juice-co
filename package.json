{
  "name": "undead-juice-co",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "phaser": "3.90.0",
    "workbox-window": "7.4.1",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "1.0.4",
    "gh-pages": "6.3.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "icons": "pwa-assets-generator",
    "deploy": "npm run build && gh-pages -d dist -t"
  }
}
